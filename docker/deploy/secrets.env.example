# Template for this stack's shared/secrets.env on prodbox. Copy to
# /opt/canonry-landing/<stack>/shared/secrets.env, fill in real values, `chmod 600` it.
# release.sh reads this file and copies it (plus the release-specific
# LANDING_IMAGE/APP_VERSION/APP_COMMIT) into every releases/<sha>/.env, but never
# writes to this file itself. This file is never committed; only this template is.
#
# prod and preview need different POSTGRES_PASSWORD and different ports (so both
# stacks' containers can publish to loopback on the same box without colliding) - see
# docker/Caddyfile.example for the port convention (prod 5195, preview 5295).
#
# This stack's Postgres is this repository's own (docker/deploy/compose.deploy.yml
# bundles it), holding exactly the waitlist_signup table migrations/0001_waitlist_signup.sql
# creates - never the canonry product repository's database, even though both stacks
# may run on the same physical prodbox.
#
# POSTGRES_PASSWORD is interpolated unescaped into DATABASE_URL below, which a
# postgres:// client parses as a URL: a raw `openssl rand -base64` password can
# contain `/`, `+` or `=`, and any of those turns a valid password into an
# invalid DSN (this cost a real deploy 90 seconds of health-gate timeout and a
# container-log read to diagnose, before it was worth this comment). Generate a
# URL-safe secret instead, and use the same value in both places:
#
#   openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
#
# (or `openssl rand -hex 32`, which is URL-safe by construction). release.sh's
# own release step now refuses to start a stack whose DATABASE_URL fails to
# parse as a URL, naming the variable rather than surfacing this as a 500 deep
# in the app's logs -- but generating it right the first time is still cheaper.

LANDING_PORT=5195
POSTGRES_PORT=5433

POSTGRES_USER=canonry
POSTGRES_PASSWORD=change-me-generate-a-real-secret
POSTGRES_DB=canonry_landing
DATABASE_URL=postgres://canonry:change-me-generate-a-real-secret@postgres:5432/canonry_landing

ORIGIN=https://canonry.io
